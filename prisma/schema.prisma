// Funeral Memorial SaaS - Production Schema
// Phase 4A: MemoryCategory, MemorialSettings, Memory enhancements
// Phase 7:  Reaction model
// Phase 8:  StripeCustomer, Entitlement extended, Cultural warning fields
// Phase 9:  PageView model for visitor analytics
// Phase 10: Automation fields — nominatedEmail, autoSentAt, expiryWarningSentAt, Memory.stale
// Phase 11: CollectionItem, CollectionInvite — staging workspace
// Phase 12: PreviewSession — preview before publish
// Phase 13: MemorialHandover — ownership transfer funeral home → family
// Phase 14: Photo manager fields on CollectionItem, service fields on Memorial
// Phase 15: TributeVideo, MusicTrack
// Phase 16: GuestBookEntry (dedicated model)
// Phase 17: White-label foundations + QR lifecycle + ProductRequest

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================================================
// ENUMS
// ============================================================================

enum MemorialStatus {
  ACTIVE
  ARCHIVED
  SUSPENDED
}

enum MemoryStatus {
  PENDING
  APPROVED
  REJECTED
}

enum MediaStatus {
  PENDING
  APPROVED
  REJECTED
}

enum EntitlementTier {
  FREE
  BASIC
  PREMIUM
}

enum SubscriptionStatus {
  NONE
  ACTIVE
  PAST_DUE
  CANCELED
  INCOMPLETE
}

enum MemoryCategory {
  GENERAL
  CONDOLENCE
  STORY
  TRIBUTE
  GUEST_BOOK
}

// Phase 11 ────────────────────────────────────────────────────────────────────

enum CollectionItemStatus {
  UNSORTED
  READY
  APPROVED
  REJECTED
}

enum CollectionItemType {
  PHOTO
  VIDEO
  STORY
  DOCUMENT
}

enum CollectionInviteStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

// Phase 13 ────────────────────────────────────────────────────────────────────

enum HandoverStatus {
  PENDING
  SCHEDULED
  COMPLETED
  CANCELLED
}

// Phase 15 ────────────────────────────────────────────────────────────────────

enum VideoStatus {
  DRAFT
  RENDERING
  COMPLETE
  FAILED
}

enum VideoTheme {
  CLASSIC
  MODERN
  RUSTIC
  CELEBRATION
}

enum MusicCategory {
  PEACEFUL
  UPLIFTING
  CLASSICAL
  HYMN
  INSTRUMENTAL
  CELEBRATION
}

// Phase 16 ────────────────────────────────────────────────────────────────────

enum GuestBookStatus {
  PENDING
  APPROVED
  REJECTED
}

// Phase 17 ────────────────────────────────────────────────────────────────────
// QRState is defined here for documentation and future enum migration.
// Memorial.qrState is stored as String for now — safer to migrate existing rows.
// Will be converted to this enum in a future phase after QR routing is stable.

enum ProductRequestStatus {
  REQUESTED
  QUOTED
  APPROVED
  FULFILLED
  CANCELLED
}

// Phase 18: Case Lite status. Stored as a real enum (unlike QRState, which
// is intentionally a String for lifecycle flexibility) — case status has a
// small, fixed set of values that never needs runtime extension.
enum CaseStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

// Pet aftercare — 5 fixed journey stages (see docs/pet-aftercare workflow
// notes). Deliberately a real enum, not a free-text field like
// Memorial.workflowStage — the pet journey has a small, fixed, ordered set
// of stages with no per-org customisation planned, so an enum buys
// compile-time safety and makes "what stage is this case in" queryable
// without string matching. If a future org ever needs custom pet
// workflows, that's a bigger design change, not an incremental add here.
enum PetCaseStage {
  INTAKE // Case created, pickup/drop-off arranged, not yet at the facility
  RECEIVED // Pet received at the facility, identity/paperwork checked
  IN_CARE // Cremation/aquamation in progress
  READY // Process complete, ashes/products ready for return
  RETURNED // Ashes returned to owner — terminal stage
}

// How the case first entered the system. Mirrors the "Vet / Owner" intake
// branch in the original pet workflow notes — vets are the more common
// referral source in practice, so this is tracked distinctly from a
// walk-in owner rather than folded into a generic "source" free-text field.
enum PetIntakeSource {
  VET
  OWNER
  WALK_IN
}

// ============================================================================
// MODELS
// ============================================================================

model Memorial {
  id             String         @id @default(cuid())
  ownerId        String
  organisationId String?
  title          String
  firstName      String?
  lastName       String?
  preferredName  String?
  birthDate      DateTime?
  deathDate      DateTime?
  description    String?
  qrTokenHash    String         @unique
  contentHash    String?
  status         MemorialStatus @default(ACTIVE)
  readOnly       Boolean        @default(false)
  sealed         Boolean        @default(false)
  sealedAt       DateTime?
  createdAt      DateTime       @default(now())
  expiresAt      DateTime?
  sendAfterDays  Int?

  // Phase 8: Cultural warning flags
  isAboriginal           Boolean @default(false)
  isTorresStraitIslander Boolean @default(false)
  isSouthSeaIslander     Boolean @default(false)
  isMaori                Boolean @default(false)

  // Phase 10: Automation
  nominatedEmail      String?
  nominatedName       String?
  autoSentAt          DateTime?
  expiryWarningSentAt DateTime?

  // Memorial journey automation — funeral-home operations timeline
  // (see lib/memorial/journeyGate.ts). Manual early-unlock for Tribute
  // Video, plus one-shot guards so the two cron reminder emails never
  // send twice for the same memorial.
  tributeUnlockOverride Boolean   @default(false)
  lastChanceEmailSentAt DateTime?
  publishPromptSentAt   DateTime?

  // Phase 11-13: Workflow
  workflowStage   String    @default("COLLECTING")
  publishedAt     DateTime?
  // Per-memorial family-consent attestation — the funeral home confirms
  // they have the family's consent to publish THIS specific memorial's
  // content, distinct from the org-level Terms/Privacy acceptance at
  // signup (Organisation.termsAcceptedAt above). Deliberately a manual,
  // separate action rather than something publish sets automatically —
  // the whole point is a deliberate attestation step, not implied
  // consent from clicking Publish. Enforced as a hard gate in
  // app/api/memorial/[memorialId]/publish/route.ts.
  familyConsentConfirmed         Boolean   @default(false)
  familyConsentConfirmedAt       DateTime?
  familyConsentConfirmedByUserId String?
  funeralDate     DateTime?
  collectionNotes String?   @db.Text

  // Phase 14: Service details
  serviceType    String?
  serviceTime    DateTime?
  venueName      String?
  venueAddress   String?
  placeOfPassing String?
  heroImageKey   String?

  // Phase 14: Upload link (simple public photo sharing)
  uploadLinkToken   String? @unique
  uploadLinkEnabled Boolean @default(true)

  // Phase 14: Family contact captured at creation
  familyContactName  String?
  familyContactEmail String?
  familyContactPhone String?

  // Phase 17: QR lifecycle ───────────────────────────────────────────────────
  // publicToken: permanent token used for /v/[token] routing.
  // Completely separate from qrTokenHash (the V1 /m/[hash] path).
  // Generated lazily on first QR panel open. Never changes once set.
  // Safe to print on physical materials — permanent for decades.
  publicToken    String?   @unique
  // qrState: stored as String (not enum) to allow safer migration of existing rows.
  // Valid values: PRE_SERVICE | SERVICE_ACTIVE | UNLOCK_PENDING |
  //               MEMORIAL_OPEN | PRIVATE | ARCHIVED
  // Default MEMORIAL_OPEN ensures all V1 memorials remain publicly accessible
  // after migration — no action required by funeral homes.
  qrState        String    @default("MEMORIAL_OPEN")
  // serviceStartAt: precise combined datetime of the service.
  // Separate from funeralDate + serviceTime (V1 fields, kept unchanged).
  // Used only by the QR state machine.
  serviceStartAt DateTime?
  // unlockAt: datetime when memorial auto-transitions to MEMORIAL_OPEN.
  // Background cron job checks this every 5 minutes.
  unlockAt       DateTime?

  // Phase 17: Pamphlet config
  // These fields supplement the V1 service fields above (venueName, venueAddress,
  // serviceType, serviceTime). V1 fields are unchanged and reused by PamphletView.
  pamphletEnabled   Boolean @default(false)
  pamphletTitle     String?
  pamphletVenueNote String?
  pamphletMessage   String? @db.Text

  // ── ADDED: clean public URL slug ────────────────────────────────────────
  // Public, human-readable path segment, e.g. "john-smith". NOT a secret —
  // access is still gated by the `key` query param against
  // qrTokenHash/publicToken. Nullable for now; tightened to NOT NULL +
  // @unique in a follow-up migration once existing rows are backfilled.
  slug String?

  // Relations - existing (UNCHANGED)
  memories    Memory[]
  media       Media[]
  entitlement Entitlement?
  settings    MemorialSettings?
  pageViews   PageView[]

  // Relations - Phase 11-13 (UNCHANGED)
  collectionItems   CollectionItem[]
  collectionInvites CollectionInvite[]
  previewSessions   PreviewSession[]
  handover          MemorialHandover?

  // Relations - Phase 15-16 (UNCHANGED)
  tributeVideo     TributeVideo?
  guestBookEntries GuestBookEntry[]

  // Relations - SaaS launch (UNCHANGED)
  organisation Organisation? @relation(fields: [organisationId], references: [id])

  // Relations - Phase 17
  productRequests ProductRequest[]

  // Phase 18: reverse relation to FuneralCase. One case per memorial
  // (memorialId is @unique on FuneralCase). Nullable — most memorials
  // won't have a case, especially existing V1 memorials.
  funeralCase FuneralCase?

  // Pet aftercare: reverse relation to PetCase, same one-per-memorial
  // shape as funeralCase above (memorialId is @unique on PetCase too).
  // A memorial created via "create memorial from pet case" links back
  // here; a memorial created the normal human way leaves this null.
  petCase PetCase?

  @@index([ownerId])
  @@index([organisationId])
  @@index([qrTokenHash])
  @@index([publicToken]) // Phase 17
  @@index([qrState]) // Phase 17
  @@index([unlockAt]) // Phase 17
  @@index([status])
  @@index([createdAt])
  @@index([sealed])
  @@index([expiresAt])
  @@index([autoSentAt])
  @@index([sendAfterDays])
  @@index([workflowStage])
  @@index([uploadLinkToken])
  @@index([slug])
  @@map("memorials")
}

model MemorialSettings {
  id              String   @id @default(cuid())
  memorialId      String   @unique
  heroLayout      String   @default("full-bleed")
  theme           String   @default("light")
  primaryColor    String?
  backgroundColor String?
  fontFamily      String?
  showTimeline    Boolean  @default(true)
  showGallery     Boolean  @default(true)
  showGuestBook   Boolean  @default(true)
  showMemoryCount Boolean  @default(true)
  guestBookTitle  String?
  guestBookPrompt String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  memorial Memorial @relation(fields: [memorialId], references: [id], onDelete: Cascade)

  @@index([memorialId])
  @@map("memorial_settings")
}

model Memory {
  id               String         @id @default(cuid())
  memorialId       String
  authorName       String?
  message          String         @db.Text
  contentHash      String?
  status           MemoryStatus   @default(PENDING)
  sealed           Boolean        @default(false)
  sealedAt         DateTime?
  createdAt        DateTime       @default(now())
  rejectedAt       DateTime?
  isGuestBook      Boolean        @default(false)
  featured         Boolean        @default(false)
  category         MemoryCategory @default(GENERAL)
  visibleUntil     DateTime?
  stale            Boolean        @default(false)
  collectionItemId String?
  // ADDED — family self-service hide, independent of `status` above.
  // status is the funeral home's moderation decision (visible to public
  // at all); familyHidden is the family's own display preference on top
  // of that. Something can be status=APPROVED and familyHidden=true
  // simultaneously — those are different questions. Deliberately left
  // togglable even on sealed memories: sealing freezes content integrity
  // (the message/author can't be silently altered), not display state.
  familyHidden     Boolean        @default(false)

  memorial       Memorial        @relation(fields: [memorialId], references: [id], onDelete: Restrict)
  media          Media[]
  reactions      Reaction[]
  collectionItem CollectionItem? @relation(fields: [collectionItemId], references: [id], onDelete: SetNull)

  @@index([memorialId])
  @@index([status])
  @@index([createdAt])
  @@index([sealed])
  @@index([memorialId, isGuestBook])
  @@index([memorialId, featured])
  @@index([memorialId, category])
  @@index([status, createdAt])
  @@index([collectionItemId])
  @@map("memories")
}

model Media {
  id         String      @id @default(cuid())
  memorialId String
  memoryId   String?
  blobKey    String
  mimeType   String
  sizeBytes  Int
  status     MediaStatus @default(PENDING)
  createdAt  DateTime    @default(now())
  rejectedAt DateTime?

  memorial Memorial @relation(fields: [memorialId], references: [id], onDelete: Restrict)
  memory   Memory?  @relation(fields: [memoryId], references: [id], onDelete: Restrict)

  @@index([memorialId])
  @@index([memoryId])
  @@index([status])
  @@index([createdAt])
  @@map("media")
}

model Reaction {
  id           String   @id @default(cuid())
  memoryId     String
  visitorToken String
  emoji        String
  createdAt    DateTime @default(now())

  memory Memory @relation(fields: [memoryId], references: [id], onDelete: Cascade)

  @@unique([memoryId, visitorToken, emoji])
  @@index([memoryId])
  @@map("reactions")
}

model PageView {
  id           String   @id @default(cuid())
  memorialId   String
  visitorToken String
  referrer     String?
  createdAt    DateTime @default(now())

  memorial Memorial @relation(fields: [memorialId], references: [id], onDelete: Cascade)

  @@index([memorialId])
  @@index([memorialId, createdAt])
  @@index([visitorToken])
  @@map("page_views")
}

model StripeCustomer {
  id               String   @id @default(cuid())
  userId           String   @unique
  stripeCustomerId String   @unique
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([userId])
  @@index([stripeCustomerId])
  @@map("stripe_customers")
}

model Entitlement {
  id                  String             @id @default(cuid())
  memorialId          String             @unique
  tier                EntitlementTier    @default(FREE)
  subscriptionStatus  SubscriptionStatus @default(NONE)
  stripeSubId         String?            @unique
  subscriptionPriceId String?
  currentPeriodEnd    DateTime?
  storagePaid         Boolean            @default(false)
  storageCheckoutId   String?
  storagePaidAt       DateTime?
  storageExpiresAt    DateTime?
  active              Boolean            @default(true)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  memorial Memorial @relation(fields: [memorialId], references: [id], onDelete: Restrict)

  @@index([memorialId])
  @@index([stripeSubId])
  @@index([active])
  @@index([storagePaid])
  @@index([storageExpiresAt])
  @@map("entitlements")
}

model AuditEvent {
  id         String   @id @default(uuid())
  entityType String
  entityId   String
  action     String
  actorId    String
  actorRole  String
  reasonCode String
  timestamp  DateTime @default(now())
  metadata   Json?

  @@index([entityId])
  @@index([timestamp])
  @@index([entityType, entityId])
  @@map("audit_events")
}

// ============================================================================
// PHASE 11 — COLLECTION WORKSPACE
// ============================================================================

model CollectionItem {
  id               String               @id @default(cuid())
  memorialId       String
  uploadedBy       String // Clerk userId (staff) | "public:[uploadLinkToken]" | "invite:[inviteId]"
  uploaderRole     String // "STAFF" | "FAMILY" | "PUBLIC"
  inviteId         String?
  type             CollectionItemType
  status           CollectionItemStatus @default(UNSORTED)
  title            String?
  description      String?              @db.Text
  category         MemoryCategory?
  blobKey          String?
  mimeType         String?
  sizeBytes        Int?
  showPublicly     Boolean              @default(false)
  featured         Boolean              @default(false)
  sortOrder        Int?
  promotedMemoryId String?
  rejectionReason  String?
  reviewedBy       String?
  reviewedAt       DateTime?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  // Phase 14: Photo manager fields
  uploaderName    String? // Name entered at public upload link
  uploaderEmail   String? // Email entered at public upload link (optional)
  caption         String? // Caption shown in memorial gallery
  forTribute      Boolean @default(false)
  forMemorial     Boolean @default(false)
  isHero          Boolean @default(false)
  tributeOrder    Int?
  tributeDuration Float? // Override seconds for this photo in video

  memorial       Memorial          @relation(fields: [memorialId], references: [id], onDelete: Cascade)
  invite         CollectionInvite? @relation(fields: [inviteId], references: [id], onDelete: SetNull)
  promotedMemory Memory[]

  @@index([memorialId])
  @@index([memorialId, status])
  @@index([memorialId, type])
  @@index([memorialId, forTribute])
  @@index([memorialId, forMemorial])
  @@index([memorialId, isHero])
  @@index([uploadedBy])
  @@index([inviteId])
  @@index([promotedMemoryId])
  @@map("collection_items")
}

model CollectionInvite {
  id             String                 @id @default(cuid())
  memorialId     String
  createdBy      String
  token          String                 @unique
  recipientName  String?
  recipientEmail String?
  status         CollectionInviteStatus @default(PENDING)
  expiresAt      DateTime
  usedAt         DateTime?
  uploadCount    Int                    @default(0)
  createdAt      DateTime               @default(now())

  memorial Memorial         @relation(fields: [memorialId], references: [id], onDelete: Cascade)
  items    CollectionItem[]

  @@index([memorialId])
  @@index([token])
  @@index([status])
  @@index([expiresAt])
  @@map("collection_invites")
}

// ============================================================================
// PHASE 12 — PREVIEW SESSION
// ============================================================================

model PreviewSession {
  id             String    @id @default(cuid())
  memorialId     String
  createdBy      String
  token          String    @unique
  recipientName  String?
  recipientEmail String?
  expiresAt      DateTime
  viewedAt       DateTime?
  viewCount      Int       @default(0)
  createdAt      DateTime  @default(now())

  memorial Memorial @relation(fields: [memorialId], references: [id], onDelete: Cascade)

  @@index([memorialId])
  @@index([token])
  @@index([expiresAt])
  @@map("preview_sessions")
}

// ============================================================================
// PHASE 13 — HANDOVER
// ============================================================================

model MemorialHandover {
  id                   String         @id @default(cuid())
  memorialId           String         @unique
  initiatedBy          String
  status               HandoverStatus @default(PENDING)
  familyContactName    String
  familyContactEmail   String
  familyContactPhone   String?
  familyClerkUserId    String?
  scheduledAt          DateTime?
  completedAt          DateTime?
  cancelledAt          DateTime?
  cancelReason         String?
  acceptToken          String?        @unique
  acceptTokenExpiresAt DateTime?
  notificationSentAt   DateTime?
  previousOwnerId      String
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  // ADDED — family self-service access, separate from the acceptToken
  // flow above. acceptToken is one-time (accept → become a real Clerk
  // owner); familyAccessToken is a repeat-use, non-expiring credential
  // for the lower-friction "enter your email" control screen. The two
  // are independent: a funeral home can offer either, both, or neither.
  // Deliberately NOT unique-constrained the same way acceptToken forces
  // a value — most handovers will never generate one.
  familyAccessToken     String?  @unique
  familyAccessEnabled   Boolean  @default(false)
  familyAccessRevokedAt DateTime?

  memorial Memorial @relation(fields: [memorialId], references: [id], onDelete: Restrict)

  @@index([memorialId])
  @@index([status])
  @@index([scheduledAt])
  @@index([acceptToken])
  @@index([familyAccessToken])
  @@map("memorial_handovers")
}

// ============================================================================
// PHASE 15 — TRIBUTE VIDEO
// ============================================================================

model TributeVideo {
  id              String      @id @default(cuid())
  memorialId      String      @unique
  status          VideoStatus @default(DRAFT)
  theme           VideoTheme  @default(CLASSIC)
  musicTrackId    String?
  customMusicKey  String?
  photoOrder      Json        @default("[]")
  titleCardText   String?
  endCardText     String?
  durationSeconds Int?
  hdBlobKey       String?
  webBlobKey      String?
  // Size of the rendered video file in bytes. Added so tribute videos
  // count toward the per-memorial storage quota (STORAGE_MB_PER_MEMORIAL
  // in lib/stripe.ts) — before this field existed, a memorial's video
  // was invisible to any storage-usage calculation based on Media.sizeBytes,
  // since TributeVideo isn't a Media row. Nullable because existing rows
  // predate this field and their actual size isn't known retroactively;
  // treated as 0 bytes in usage calculations until backfilled or re-rendered.
  sizeBytes       Int?
  videoQrToken    String?     @unique
  showOnMemorial  Boolean     @default(false)
  renderedAt      DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  memorial   Memorial    @relation(fields: [memorialId], references: [id], onDelete: Cascade)
  musicTrack MusicTrack? @relation(fields: [musicTrackId], references: [id], onDelete: SetNull)

  @@index([memorialId])
  @@index([status])
  @@index([videoQrToken])
  @@map("tribute_videos")
}

model MusicTrack {
  id              String        @id @default(cuid())
  title           String
  artist          String?
  category        MusicCategory
  durationSeconds Int
  blobKey         String
  previewBlobKey  String?
  active          Boolean       @default(true)
  createdAt       DateTime      @default(now())

  tributeVideos TributeVideo[]

  @@index([category])
  @@index([active])
  @@map("music_tracks")
}

// ============================================================================
// PHASE 16 — GUEST BOOK
// ============================================================================

model GuestBookEntry {
  id              String          @id @default(cuid())
  memorialId      String
  authorName      String?
  message         String          @db.Text
  location        String?
  photoKey        String?
  status          GuestBookStatus @default(PENDING)
  pinned          Boolean         @default(false)
  ipHash          String?
  flaggedByFilter Boolean         @default(false)
  filterReason    String?
  createdAt       DateTime        @default(now())
  // ADDED — same reasoning as Memory.familyHidden above.
  familyHidden    Boolean         @default(false)

  memorial Memorial @relation(fields: [memorialId], references: [id], onDelete: Cascade)

  @@index([memorialId])
  @@index([memorialId, status])
  @@index([memorialId, pinned])
  @@index([createdAt])
  @@index([ipHash])
  @@map("guest_book_entries")
}

// ============================================================================
// PHASE 17 — PRODUCT REQUESTS
// Simple internal fulfillment queue. This is NOT ecommerce.
// Funeral homes request memorial products. Status tracks production workflow.
// ============================================================================

model ProductRequest {
  id             String  @id @default(cuid())
  memorialId     String
  // organisationId is denormalised here to avoid a join when listing
  // all product requests across an org. Always set at creation time.
  organisationId String?

  productType    String // "plaque" | "card" | "print" | "keepsake" | "other"
  quantity       Int    @default(1)
  // Flexible JSON for product-specific specifications.
  // Plaque:  { text, size, material, engraving }
  // Card:    { design, text, size }
  // Print:   { photoId, size, framed }
  specifications Json?

  status          ProductRequestStatus @default(REQUESTED)
  quotedPrice     Float?
  requestNotes    String?              @db.Text
  productionNotes String?              @db.Text

  requestedAt DateTime  @default(now())
  quotedAt    DateTime?
  approvedAt  DateTime?
  completedAt DateTime?

  memorial Memorial @relation(fields: [memorialId], references: [id], onDelete: Cascade)

  @@index([memorialId])
  @@index([organisationId])
  @@index([status])
  @@index([requestedAt])
  @@map("product_requests")
}

// ============================================================================
// PHASE 18 — CASE LITE
// Operational wrapper for a funeral. Exists independently of a memorial —
// created at intake (CSV import or manual entry), linked to a memorial later.
// One case : one memorial (memorialId is @unique below).
// ============================================================================

model FuneralCase {
  id             String @id @default(cuid())
  organisationId String
  // Free-text reference from the funeral home's own system, e.g. "2026-0042".
  // Unique per org (not globally) — different orgs can reuse the same ref.
  caseRef        String

  deceasedName  String
  familyContact String?
  contactEmail  String?
  contactPhone  String?
  serviceDate   DateTime?
  // venue: kept for backward compat (deprecated, not removed — same
  // pattern used elsewhere this session). venueName/venueAddress are
  // the real fields going forward, matching the richer format Memorial
  // already used — see lib/memorial/resolveMemorialFields.ts.
  venue         String?
  venueName     String?
  venueAddress  String?
  notes         String?   @db.Text

  status CaseStatus @default(ACTIVE)

  // Linked memorial once one is created from this case. Nullable — a case
  // can exist for a while at intake before a memorial is built from it.
  // @unique enforces one case per memorial (onDelete: SetNull — deleting
  // the memorial does NOT delete the case, per the intake-first workflow).
  memorialId String?   @unique
  memorial   Memorial? @relation(fields: [memorialId], references: [id], onDelete: SetNull)

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organisationId, caseRef])
  @@index([organisationId])
  @@index([organisationId, status])
  @@index([serviceDate])
  @@index([memorialId])
  @@map("funeral_cases")
}

// ============================================================================
// PET AFTERCARE — separate model from FuneralCase by design.
//
// The two case types share almost no fields in practice (owner vs family
// contact, species/breed vs venue/celebrant, 5 fixed stages vs open funeral
// arrangements) and a shared/inherited model would recreate exactly the
// "one source of truth" overlap problem that Priority 3 spent real effort
// cleaning up between FuneralCase and Memorial. If genuine overlap emerges
// later (e.g. both eventually need a shared Organisation-level case list),
// that's a deliberate future refactor, not a default to design toward now.
// ============================================================================

model PetCase {
  id             String @id @default(cuid())
  organisationId String

  // Free-text reference from the crematorium's own system, e.g. "PET-0087".
  // Unique per org (not globally) — mirrors FuneralCase.caseRef exactly.
  caseRef String

  petName String
  species String? // "Dog", "Cat", "Rabbit", etc — free text, not an enum:
  // crematoriums handle enough variety (birds, reptiles, horses on rare
  // occasion) that a fixed list would need constant extension for little
  // benefit over a simple text field with input suggestions in the UI.
  breed  String?

  // Owner — deliberately named ownerContact*, not familyContact* or
  // nominated*, so this can never be confused with Memorial's family-
  // contact fields if/when a memorial is created from this case. The
  // owner is who receives the tracker link and the ashes-ready notice.
  ownerContactName  String
  ownerContactEmail String?
  ownerContactPhone String?

  // Referring vet, when intakeSource is VET. Optional even then — some
  // vets phone it in without a formal referral record.
  intakeSource   PetIntakeSource @default(OWNER)
  vetClinicName  String?
  vetContactName String?
  vetContactEmail String?
  vetContactPhone String?

  stage PetCaseStage @default(INTAKE)

  serviceType String? // "Private cremation", "Communal cremation", "Aquamation" — free
  // text for the same reason as species: the workflow doc lists these as
  // examples, not an exhaustive fixed catalogue, and org-specific service
  // names are likely (see FuneralCase.venue precedent for why this
  // codebase prefers text over premature enums here).

  notes String? @db.Text

  status CaseStatus @default(ACTIVE)

  // QR / identification — every pet case gets a physical tag/QR from
  // intake (see original workflow notes: "QR identification" happens
  // immediately after collection, before the facility even receives the
  // animal). Separate from the owner tracker's own public token below —
  // this one is scanned by STAFF to pull up the case and confirm identity
  // at each handoff point, not shown to the owner.
  qrTokenHash String? @unique

  // Owner-facing public tracker — the direct analog of Memorial's
  // publicToken/slug pair for /v/[slug]. Deliberately its own token
  // rather than reusing Memorial's, because a pet case can exist (and be
  // tracked by the owner) for weeks before any memorial is created, and
  // should keep working even if a memorial never gets created at all.
  trackerToken String? @unique

  // Linked memorial once "create memorial from pet case" has run.
  // Nullable + unique + SetNull, matching FuneralCase's exact pattern —
  // deleting the memorial does not delete the pet case record.
  memorialId String?   @unique
  memorial   Memorial? @relation(fields: [memorialId], references: [id], onDelete: SetNull)

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  stageEvents PetCaseStageEvent[]

  // Reverse relation: set only if this case originated from an approved
  // PetIntakeRequest. Most cases won't have one (staff-created directly
  // via the New Pet Case form) — nullable, one-to-one.
  intakeRequest PetIntakeRequest?

  collectedAt DateTime? // stage: INTAKE → RECEIVED trigger point
  receivedAt  DateTime?
  readyAt     DateTime?
  returnedAt  DateTime? // terminal — stage RETURNED

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organisationId, caseRef])
  @@index([organisationId])
  @@index([organisationId, status])
  @@index([organisationId, stage])
  @@index([memorialId])
  @@index([qrTokenHash])
  @@index([trackerToken])
  @@map("pet_cases")
}

// Append-only audit trail of stage transitions — deliberately a separate
// table rather than just overwriting PetCase.stage in place, because the
// owner tracker page needs to render a progress list ("Collected ✓ →
// Received ✓ → In care 🔄 → Ready → Returned") with real timestamps per
// step, not just "currently on stage X". Mirrors the append-only intent
// of AuditEvent elsewhere in this schema, but kept as its own table
// (rather than reusing AuditEvent) since this needs to be cheaply
// queryable and renderable on a public page with no auth, which the
// general-purpose internal AuditEvent table is not designed for.
model PetCaseStageEvent {
  id        String       @id @default(cuid())
  petCaseId String
  stage     PetCaseStage
  note      String? // optional staff note visible on internal case view only
  createdAt DateTime     @default(now())
  createdBy String? // staff user id; null for system-generated transitions

  petCase PetCase @relation(fields: [petCaseId], references: [id], onDelete: Cascade)

  @@index([petCaseId])
  @@map("pet_case_stage_events")
}

// Public QR intake — a vet or owner scans the org's fixed petIntakeToken
// and fills out this form themselves. Deliberately NOT written straight
// into PetCase: this is an unauthenticated, anyone-with-the-QR-code
// submission path, so it goes through the same pending-review pattern
// already used for GuestBookEntry and Memory rather than creating a live
// case directly — a bogus or duplicate submission becoming a real case
// with no staff involved would be a worse failure mode than one extra
// staff click to approve. Staff reviewing a request can edit any field
// before approving (people fill forms on their phones in stressful
// circumstances; typos and vague answers are expected), and approving
// creates the actual PetCase — see the review-queue API route.
model PetIntakeRequest {
  id             String @id @default(cuid())
  organisationId String

  submittedBy PetIntakeSource // who filled this out — same enum as PetCase.intakeSource

  petName String
  species String?
  breed   String?

  ownerContactName  String
  ownerContactEmail String?
  ownerContactPhone String?

  // Only meaningful when submittedBy is VET — same fields as PetCase's
  // vet* columns, kept separate rather than shared because this is
  // unvalidated public input, not yet a trusted staff-entered record.
  vetClinicName   String?
  vetContactName  String?
  vetContactEmail String?
  vetContactPhone String?

  serviceType String?
  notes       String? @db.Text // whatever the submitter typed in the free-text field

  status PetIntakeStatus @default(PENDING)

  // Set when a staff member approves this request and it becomes a real
  // PetCase. Nullable/unique — mirrors PetCase.memorialId's shape for a
  // one-to-one "this became that" link.
  resultingPetCaseId String?  @unique
  resultingPetCase   PetCase? @relation(fields: [resultingPetCaseId], references: [id], onDelete: SetNull)

  reviewedBy String? // staff user id who approved/rejected
  reviewedAt DateTime?
  rejectionReason String?

  // Basic spam/abuse signals — same pattern as GuestBookEntry, since this
  // is exactly the same trust level (public, unauthenticated, free text).
  ipHash String?

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([organisationId])
  @@index([organisationId, status])
  @@index([ipHash])
  @@index([createdAt])
  @@map("pet_intake_requests")
}

enum PetIntakeStatus {
  PENDING
  APPROVED
  REJECTED
}

// ============================================================================
// SAAS LAUNCH — Organisation, OrgMember, StripeEvent
// ============================================================================

enum OrgPlan {
  STARTER // $49/mo — 10 memorials/mo, 3 videos/mo, 1 seat
  PROFESSIONAL // $99/mo — unlimited memorials + videos, 3 seats, analytics
  ENTERPRISE // $249/mo — unlimited + custom branding, API access, unlimited seats
}

enum OrgRole {
  OWNER // Full access including billing — auto-assigned to creator
  ADMIN // Create/edit/delete all memorials, manage team
  MEMBER // Create/edit own memorials only
  VIEWER // Read-only dashboard access
}

model Organisation {
  id                 String             @id @default(cuid())
  clerkOrgId         String             @unique
  name               String
  slug               String             @unique
  plan               OrgPlan            @default(STARTER)
  stripeCustomerId   String?            @unique
  stripeSubId        String?            @unique
  subscriptionStatus SubscriptionStatus @default(NONE)
  stripePriceId      String?
  currentPeriodEnd   DateTime?
  cancelAtPeriodEnd  Boolean            @default(false)
  trialEndsAt        DateTime?
  // Signup-time consent — captured once, at org creation, in
  // app/api/onboarding/create-org/route.ts. Tracks WHO on the org
  // accepted (not just "the org"), WHEN, and WHICH version of the
  // Terms/Privacy Policy, since re-prompting on a future material
  // change means comparing against a stored version, not just checking
  // a boolean. See app/privacy/page.tsx and app/terms/page.tsx's own
  // "Last updated" line for the version string this should match.
  termsAcceptedAt        DateTime?
  termsAcceptedVersion   String?
  termsAcceptedByUserId  String?
  memorialsThisMonth Int                @default(0)
  videosThisMonth    Int                @default(0)
  logoKey            String? // V1: storage path key (kept for backward compat)
  brandColor         String? // V1: single brand colour (kept for backward compat)
  customDomain       String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  meteredItemId      String?

  // Phase 17: White-label branding ────────────────────────────────────────────
  // brandName: public-facing display name e.g. "Smith Funeral Services".
  // Separate from `name` which is the internal Clerk account name.
  brandName               String?
  // logoUrl: public CDN URL for the organisation logo.
  // Separate from logoKey (V1 storage path). Used in MemorialShell header.
  logoUrl                 String?
  // primaryColor: Phase 17 hex colour field.
  // Falls back to brandColor (V1) if null. Falls back to #c9a96e if both null.
  primaryColor            String?
  secondaryColor          String?
  supportEmail            String?
  // poweredByEnabled: when true, public pages show "Powered by Memoriam" footer.
  // Defaults true. White-label customers can set false.
  poweredByEnabled        Boolean @default(true)
  // isWhiteLabelEnabled: master white-label toggle.
  // When false (all 3 existing funeral homes after migration), Memoriam defaults
  // are used for all public pages. Nothing changes for them until this is enabled.
  isWhiteLabelEnabled     Boolean @default(false)
  // defaultUnlockDelayHours: used to pre-fill unlockAt when configuring QR lifecycle.
  // = serviceStartAt + this many hours.
  defaultUnlockDelayHours Int     @default(24)

  // Phase 17: Per-org feature flags ───────────────────────────────────────────
  // All default false. No V2 feature is accessible to any org until explicitly
  // enabled. The 3 existing funeral homes see zero change after migration.
  featureQrLifecycle Boolean @default(false)
  featurePamphlet    Boolean @default(false)
  featureSlideshow   Boolean @default(false)
  featureProducts    Boolean @default(false)
  // Phase 18: Case Lite feature flag. Default false — no existing org sees
  // Cases until explicitly enabled.
  featureCaseLite    Boolean @default(false)
  // Pet aftercare feature flag. Same additive pattern as featureCaseLite —
  // default false, so this is entirely opt-in and invisible to the 3
  // existing human-funeral customers unless/until explicitly enabled per
  // org (matches the "depth over breadth" rollout approach — pet
  // crematorium prospects get this turned on individually, not globally).
  featurePetAftercare Boolean @default(false)
  // Org-level, reusable QR intake token — printed once (e.g. at the front
  // desk, or handed to a referring vet clinic) rather than generated
  // per-submission like CollectionInvite.token. Anyone who scans it can
  // submit a pet intake request; see PetIntakeRequest for why that lands
  // in a review queue rather than creating a live PetCase directly.
  // Nullable: generated lazily on first use, same pattern as
  // Memorial.publicToken.
  petIntakeToken      String? @unique

  // Phase 19: Per-org email notification overrides. Null = use platform
  // defaults (see lib/email/policy.ts). Additive, nullable, no backfill needed.
  notificationPrefs Json?

  members      OrgMember[]
  invites      OrgInvite[]
  memorials    Memorial[]
  funeralCases FuneralCase[]
  petCases     PetCase[]
  petIntakeRequests PetIntakeRequest[]

  @@index([clerkOrgId])
  @@index([slug])
  @@index([stripeCustomerId])
  @@index([stripeSubId])
  @@map("organisations")
}

model OrgMember {
  id             String   @id @default(cuid())
  organisationId String
  userId         String
  role           OrgRole  @default(MEMBER)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@unique([organisationId, userId])
  @@index([userId])
  @@index([organisationId])
  @@map("org_members")
}

model StripeEvent {
  id        String   @id
  type      String
  processed Boolean  @default(false)
  payload   Json
  error     String?
  createdAt DateTime @default(now())

  @@index([type])
  @@index([processed])
  @@map("stripe_events")
}

// ── ADDED: rate limiting for public write endpoints ──────────────────────
//
// GuestBookEntry already has its own ipHash column and does IP-based rate
// limiting inline (3/hour, checked via guestBookEntry.count). Memory,
// Media, and Reaction have no equivalent column, so — rather than adding
// an ipHash column to three separate tables and duplicating the count
// query in three route files — this is one small shared table that all
// three (and any future public endpoint) write a row to and query
// against. See lib/rateLimit.ts for the helper that uses this.
model RateLimitHit {
  id        String   @id @default(cuid())
  // e.g. "memory:cm123abc" or "media:cm123abc" — kind + memorialId, so
  // limits are scoped per-memorial, not global across the whole app.
  bucket    String
  ipHash    String
  createdAt DateTime @default(now())

  @@index([bucket, ipHash, createdAt])
  @@map("rate_limit_hits")
}

enum OrgInviteStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

model OrgInvite {
  id               String          @id @default(cuid())
  organisationId   String
  invitedByUserId  String          // Clerk userId of the OWNER/ADMIN who sent it
  email            String          // who the invite was sent to
  role             OrgRole         @default(MEMBER)
  token            String          @unique
  status           OrgInviteStatus @default(PENDING)
  expiresAt        DateTime
  acceptedAt       DateTime?
  acceptedByUserId String?         // Clerk userId of whoever actually accepted —
                                    // may differ from the invited email's account
                                    // if the invite link was forwarded; the accept
                                    // route decides whether to allow that (see
                                    // app/api/org/invite/[token]/accept/route.ts)
  createdAt        DateTime        @default(now())

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@index([organisationId])
  @@index([token])
  @@index([email])
  @@index([status])
  @@map("org_invites")
}

model PlatformSettings {
  id              String   @id @default("singleton")
  trialDays       Int      @default(30)
  promoActive     Boolean  @default(false)
  promoLabel      String?
  updatedAt       DateTime @updatedAt
  updatedByUserId String?

  @@map("platform_settings")
}