# Copy this file to .env.local and fill in real values.
# Never commit .env or .env.local — see .gitignore.

# === Database (Neon) ===
DATABASE_URL="postgresql://..."

# === Clerk (auth) ===
CLERK_SECRET_KEY="sk_..."
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_..."

# === App ===
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# === Stripe (billing) ===
STRIPE_SECRET_KEY="sk_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_STARTER_PRICE_ID="price_..."
STRIPE_PROFESSIONAL_PRICE_ID="price_..."
STRIPE_ENTERPRISE_PRICE_ID="price_..."

# === Resend (email) ===
RESEND_API_KEY=""
RESEND_FROM_EMAIL=""
PRODUCT_ORDER_EMAIL=""

# === Cron (Vercel Cron / scheduled jobs) ===
# Generate with: openssl rand -hex 32
CRON_SECRET=""

# === Abuse-tracking IP hash salt ===
# Generate with: openssl rand -hex 32
# If unset, falls back to a hardcoded salt in lib/rateLimit.ts — set this
# before launch (see env-hygiene fix from this session for details).
IP_HASH_SALT=""

# === Platform admin allowlist ===
# Comma-separated Clerk user IDs. Empty = nobody has platform-admin access.
PLATFORM_ADMIN_USER_IDS=""

# === AWS/S3 (production file storage only — dev uses local disk) ===
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="ap-southeast-2"
AWS_S3_BUCKET=""

# === Optional ===
NEXT_PUBLIC_CDN_URL=""
NEXT_PUBLIC_FFMPEG_CORE_URL=""
LOCAL_UPLOAD_DIR="./uploads"
