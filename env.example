# Copy this file to .env.local and fill in real values.
# Never commit .env or .env.local — see .gitignore.

# === Database (Neon) ===
DATABASE_URL="postgresql://..."

# === Clerk (auth) ===
CLERK_SECRET_KEY="sk_..."
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_..."

# === App ===
# Fine for local dev. In Vercel, set this to your real deployed URL
# (e.g. https://your-app.vercel.app) for the Production environment —
# lib/env.ts now fails the build if this is still "localhost" in
# production, because it silently ended up set that way once already
# and every QR code/invite link/handover link printed the wrong URL.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# === Billing (manual invoices — see lib/billing/) ===
# Printed on every emailed statement. Statements cannot be sent without it.
# Use \n for line breaks.
BILLING_PAYMENT_INSTRUCTIONS="Pay by bank transfer to: Account name, BSB 000-000, Account 00000000"
# Days from sending until payment is due (default 14)
BILLING_DUE_DAYS="14"
# Timezone that decides which month a memorial belongs to (default Australia/Sydney)
BILLING_TIMEZONE="Australia/Sydney"
# "true" = the monthly cron emails each new statement immediately.
# Default false = it only creates drafts for you to review and send.
BILLING_AUTO_SEND="false"

# === Resend (email) ===
RESEND_API_KEY=""
RESEND_FROM_EMAIL=""
PRODUCT_ORDER_EMAIL=""

# === Cron (Vercel Cron / scheduled jobs) ===
# Generate with: openssl rand -hex 32
CRON_SECRET=""

# === Family self-service access (lib/familyAccess.ts) ===
# Signs the family-access session cookie. Hard-required — there is no
# fallback if this is unset. Deliberately a separate secret from
# CRON_SECRET/IP_HASH_SALT so rotating one never affects the others.
# Generate with: openssl rand -hex 32
FAMILY_SESSION_SECRET=""

# === Abuse-tracking IP hash salt ===
# Generate with: openssl rand -hex 32
# If unset, falls back to a hardcoded salt in lib/rateLimit.ts — set this
# before launch (see env-hygiene fix from this session for details).
IP_HASH_SALT=""

# === Platform admin allowlist ===
# Comma-separated Clerk user IDs. Empty = nobody has platform-admin access.
PLATFORM_ADMIN_USER_IDS=""

# === AWS/S3 (Cloudflare R2) — production file storage only, dev uses local disk ===
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="auto"
AWS_S3_BUCKET=""
# R2 account ID — lib/storage-s3.ts builds the endpoint as
# https://<CF_ACCOUNT_ID>.r2.cloudflarestorage.com. Required in production;
# if unset the app still boots, but every upload/download fails at request
# time (see lib/env.ts).
CF_ACCOUNT_ID=""

# === Optional ===
NEXT_PUBLIC_CDN_URL=""
NEXT_PUBLIC_FFMPEG_CORE_URL=""
LOCAL_UPLOAD_DIR="./uploads"

# === Edge route protection (see proxy.ts and lib/edgeAuth.ts) ===
# log     (default) blocks nothing; logs "[edge-auth] WOULD BLOCK ..." for signed-out
#         requests that enforce mode would stop. Safe to deploy.
# enforce signed-out API calls get 401, pages redirect to sign-in. Unknown paths blocked.
# off     disable the layer (emergency switch).
# Roll out: deploy in log mode -> use the app -> check Vercel logs are clean -> enforce.
EDGE_AUTH_MODE="enforce"
