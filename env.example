# Copy this file to .env.local and fill in real values.
# Never commit .env or .env.local — see .gitignore.

# === Database (Neon) ===
DATABASE_URL="postgresql://..."

# === Clerk (auth) ===
CLERK_SECRET_KEY="sk_..."
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_..."

# === App ===
# Fine for local dev. In Vercel, set this to your real deployed URL
# (e.g. https://your-app.vercel.app) for the Production environment —
# lib/env.ts now fails the build if this is still "localhost" in
# production, because it silently ended up set that way once already
# and every QR code/invite link/handover link printed the wrong URL.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# === Stripe (billing) ===
# $99/mo base fee + $199/memorial metered usage — see lib/stripe.ts.
# (Previously STRIPE_STARTER_PRICE_ID / PROFESSIONAL / ENTERPRISE from an
# old 3-tier pricing model — those aren't read anywhere in the code anymore.)
STRIPE_SECRET_KEY="sk_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_BASE_PRICE_ID="price_..."
STRIPE_MEMORIAL_PRICE_ID="price_..."

# === Resend (email) ===
RESEND_API_KEY=""
RESEND_FROM_EMAIL=""
PRODUCT_ORDER_EMAIL=""

# === Cron (Vercel Cron / scheduled jobs) ===
# Generate with: openssl rand -hex 32
CRON_SECRET=""

# === Family self-service access (lib/familyAccess.ts) ===
# Signs the family-access session cookie. Hard-required — there is no
# fallback if this is unset. Deliberately a separate secret from
# CRON_SECRET/IP_HASH_SALT so rotating one never affects the others.
# Generate with: openssl rand -hex 32
FAMILY_SESSION_SECRET=""

# === Abuse-tracking IP hash salt ===
# Generate with: openssl rand -hex 32
# If unset, falls back to a hardcoded salt in lib/rateLimit.ts — set this
# before launch (see env-hygiene fix from this session for details).
IP_HASH_SALT=""

# === Platform admin allowlist ===
# Comma-separated Clerk user IDs. Empty = nobody has platform-admin access.
PLATFORM_ADMIN_USER_IDS=""

# === AWS/S3 (Cloudflare R2) — production file storage only, dev uses local disk ===
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="auto"
AWS_S3_BUCKET=""
# R2 account ID — lib/storage-s3.ts builds the endpoint as
# https://<CF_ACCOUNT_ID>.r2.cloudflarestorage.com. Required in production;
# if unset the app still boots, but every upload/download fails at request
# time (see lib/env.ts).
CF_ACCOUNT_ID=""

# === Optional ===
NEXT_PUBLIC_CDN_URL=""
NEXT_PUBLIC_FFMPEG_CORE_URL=""
LOCAL_UPLOAD_DIR="./uploads"
