diff --git a/app/api/memorial/[memorialId]/collection/bulk/complete/route.ts b/app/api/memorial/[memorialId]/collection/bulk/complete/route.ts
new file mode 100644
index 0000000..68bb9f8
--- /dev/null
+++ b/app/api/memorial/[memorialId]/collection/bulk/complete/route.ts
@@ -0,0 +1,181 @@
+import { NextRequest, NextResponse } from 'next/server';
+import { auth } from '@clerk/nextjs/server';
+import { CollectionItemStatus } from '@prisma/client';
+import { prisma } from '@/lib/prisma';
+import { AuditAction, ActorRole, EntityType, ReasonCode } from '@/lib/audit';
+import { assertMemorialAccess } from '@/lib/auth/getOrgForUser';
+import { handleAuthError } from '@/lib/errors';
+import { checkRateLimit } from '@/lib/rateLimit';
+import { verifyFileContent } from '@/lib/file-validation';
+import { getMemorialStorageUsage } from '@/lib/storage-quota';
+import {
+  BULK_LIMITS, isBulkKeyForMemorial, resolveMimeType, titleFromFileName, typeForMime,
+} from '@/lib/bulk-upload';
+
+/**
+ * POST /api/memorial/[memorialId]/collection/bulk/complete
+ *
+ * Step 2 of a staff bulk upload. The browser has PUT files straight into the
+ * bucket; this route does NOT trust that. For every key it claims, it:
+ *   1. requires the key to be one this memorial's prepare step could have
+ *      issued (collection/<memorialId>/<uuid>.<ext>) — no claiming other
+ *      memorials' files or arbitrary objects;
+ *   2. HEADs the object — must exist; its REAL size is used, not the client's;
+ *   3. enforces the per-file size limit on the real size;
+ *   4. reads the first 4KB and checks the magic bytes against the type
+ *      (same stored-XSS defence as every other upload route);
+ *   5. enforces the memorial's remaining storage on real sizes, in order.
+ * Anything failing is deleted from the bucket and reported; the rest are
+ * recorded as UNSORTED CollectionItems with one audit event each.
+ * Safe to retry: keys already recorded are skipped.
+ */
+export async function POST(
+  request: NextRequest,
+  { params }: { params: Promise<{ memorialId: string }> },
+) {
+  const { memorialId } = await params;
+
+  const { userId } = await auth();
+  if (!userId) return NextResponse.json({ success: false, error: 'Unauthorised' }, { status: 401 });
+
+  try {
+    await assertMemorialAccess(memorialId, userId, 'edit');
+  } catch (err) {
+    return handleAuthError(err);
+  }
+
+  const limited = await checkRateLimit(request, `bulk-complete:${userId}`, { max: 120, windowMs: 60 * 60 * 1000 });
+  if (limited) return limited;
+
+  if (process.env.NODE_ENV !== 'production') {
+    return NextResponse.json(
+      { success: false, error: 'Direct bulk upload is only used in production (use the single-file route in dev)' },
+      { status: 400 },
+    );
+  }
+
+  let body: { items?: unknown };
+  try { body = await request.json(); } catch {
+    return NextResponse.json({ success: false, error: 'Invalid request' }, { status: 400 });
+  }
+  const raw = body?.items;
+  if (!Array.isArray(raw) || raw.length === 0 || raw.length > BULK_LIMITS.maxFilesPerBatch) {
+    return NextResponse.json({ success: false, error: 'Invalid items' }, { status: 400 });
+  }
+
+  const { s3Head, s3GetRange } = await import('@/lib/storage-s3');
+  const { deleteFile } = await import('@/lib/storage-server');
+
+  type Claim = { key: string; name: string; mimeType: string };
+  const failed: Array<{ key: string; name: string; reason: string }> = [];
+  const claims: Claim[] = [];
+  const seen = new Set<string>();
+
+  for (const r of raw as any[]) {
+    const key  = r?.key;
+    const name = typeof r?.name === 'string' ? r.name.slice(0, BULK_LIMITS.maxFileNameLength) : 'file';
+    if (!isBulkKeyForMemorial(key, memorialId) || seen.has(key)) {
+      failed.push({ key: String(key ?? ''), name, reason: 'Invalid upload reference' });
+      continue; // never touch (or delete) a key we did not issue
+    }
+    seen.add(key);
+    claims.push({ key, name, mimeType: resolveMimeType(name, typeof r?.mimeType === 'string' ? r.mimeType : '') });
+  }
+
+  // Idempotent retries: skip keys that are already recorded.
+  const existing = await prisma.collectionItem.findMany({
+    where:  { blobKey: { in: claims.map((c) => c.key) } },
+    select: { blobKey: true },
+  });
+  const already = new Set(existing.map((e) => e.blobKey));
+  const todo = claims.filter((c) => !already.has(c.key));
+
+  // Verify each object (bounded concurrency).
+  type Verified = Claim & { size: number; type: NonNullable<ReturnType<typeof typeForMime>> };
+  const verified: Verified[] = [];
+  const queue = [...todo];
+  async function worker() {
+    for (let c = queue.shift(); c; c = queue.shift()) {
+      try {
+        const type = typeForMime(c.mimeType);
+        if (!type) { failed.push({ key: c.key, name: c.name, reason: 'Unsupported file type' }); await deleteFile(c.key); continue; }
+
+        const head = await s3Head(c.key);
+        if (!head)            { failed.push({ key: c.key, name: c.name, reason: 'Upload did not finish' }); continue; }
+        if (head.size <= 0)   { failed.push({ key: c.key, name: c.name, reason: 'File is empty' }); await deleteFile(c.key); continue; }
+        if (head.size > BULK_LIMITS.maxBytes[type]) {
+          failed.push({ key: c.key, name: c.name, reason: 'File too large' }); await deleteFile(c.key); continue;
+        }
+
+        const check = verifyFileContent(await s3GetRange(c.key, 4096), c.mimeType);
+        if (!check.valid) { failed.push({ key: c.key, name: c.name, reason: check.reason }); await deleteFile(c.key); continue; }
+
+        verified.push({ ...c, size: head.size, type });
+      } catch (err) {
+        console.error('[bulk/complete] verify failed', c.key, err);
+        failed.push({ key: c.key, name: c.name, reason: 'Could not verify upload' });
+      }
+    }
+  }
+  await Promise.all(Array.from({ length: 6 }, worker));
+
+  // Storage cap on REAL sizes, in the order the client sent them.
+  const order = new Map(claims.map((c, i) => [c.key, i]));
+  verified.sort((a, b) => (order.get(a.key)! - order.get(b.key)!));
+  const usage = await getMemorialStorageUsage(memorialId);
+  let used = usage.usedBytes;
+  const toSave: Verified[] = [];
+  for (const v of verified) {
+    if (used + v.size > usage.limitBytes) {
+      failed.push({ key: v.key, name: v.name, reason: "Would exceed this memorial's storage limit" });
+      await deleteFile(v.key);
+      continue;
+    }
+    used += v.size;
+    toSave.push(v);
+  }
+
+  let items: Array<Record<string, unknown>> = [];
+  if (toSave.length > 0) {
+    try {
+      items = await prisma.$transaction(async (tx) => {
+        const created = [];
+        for (const v of toSave) {
+          created.push(await tx.collectionItem.create({
+            data: {
+              memorialId, uploadedBy: userId, uploaderRole: 'STAFF',
+              type: v.type, status: CollectionItemStatus.UNSORTED,
+              title: titleFromFileName(v.name),
+              blobKey: v.key, mimeType: v.mimeType, sizeBytes: v.size,
+            },
+          }));
+        }
+        await tx.auditEvent.createMany({
+          data: created.map((c) => ({
+            entityType: EntityType.COLLECTION_ITEM, entityId: c.id,
+            action: AuditAction.CREATE, actorId: userId, actorRole: ActorRole.OWNER,
+            reasonCode: ReasonCode.CREATION,
+            metadata: { memorialId, type: c.type, hasFile: true, sizeBytes: c.sizeBytes, bulk: true },
+          })),
+        });
+        return created.map((c) => ({
+          id: c.id, type: c.type, status: c.status, uploaderRole: c.uploaderRole,
+          title: c.title, description: c.description, category: c.category,
+          blobKey: c.blobKey, mimeType: c.mimeType, sizeBytes: c.sizeBytes,
+          showPublicly: c.showPublicly, featured: c.featured, rejectionReason: c.rejectionReason,
+          createdAt: c.createdAt.toISOString(), invite: null,
+        }));
+      }, { timeout: 30_000, maxWait: 10_000 });
+    } catch (error) {
+      console.error('[POST bulk/complete] save failed', error);
+      // Nothing was recorded, so these objects would be orphans — remove them.
+      await Promise.all(toSave.map((v) => deleteFile(v.key).catch(() => {})));
+      return NextResponse.json({ success: false, error: 'Failed to save uploaded files' }, { status: 500 });
+    }
+  }
+
+  return NextResponse.json({
+    success: true,
+    data: { items, failed, alreadyRecorded: already.size },
+  });
+}
diff --git a/app/api/memorial/[memorialId]/collection/bulk/prepare/route.ts b/app/api/memorial/[memorialId]/collection/bulk/prepare/route.ts
new file mode 100644
index 0000000..0a54444
--- /dev/null
+++ b/app/api/memorial/[memorialId]/collection/bulk/prepare/route.ts
@@ -0,0 +1,94 @@
+import { NextRequest, NextResponse } from 'next/server';
+import { randomUUID } from 'crypto';
+import { auth } from '@clerk/nextjs/server';
+import { assertMemorialAccess } from '@/lib/auth/getOrgForUser';
+import { handleAuthError } from '@/lib/errors';
+import { checkRateLimit } from '@/lib/rateLimit';
+import { getMemorialStorageUsage } from '@/lib/storage-quota';
+import { BULK_LIMITS, extensionOf, planBulkBatch, type BulkFileInput } from '@/lib/bulk-upload';
+
+/**
+ * POST /api/memorial/[memorialId]/collection/bulk/prepare
+ *
+ * Step 1 of a staff bulk upload. The client sends file METADATA only
+ * ({ name, type, size }[]); the server decides which files may be uploaded
+ * (type, per-file size, and the memorial's remaining storage — the same
+ * 5GB cap every other upload route enforces) and, in production, returns a
+ * short-lived presigned PUT URL per accepted file so the browser can send the
+ * bytes straight to R2 (Vercel Functions cannot accept large request bodies).
+ *
+ * Nothing is recorded here. Step 2 (…/bulk/complete) verifies what actually
+ * landed in the bucket and creates the CollectionItem rows.
+ *
+ * Response: { mode: 'direct' | 'server', accepted: [...], rejected: [...],
+ *             storage: { usedBytes, limitBytes, remainingBytes } }
+ *   mode 'server' (local dev, no bucket) → client falls back to the
+ *   single-file route.
+ */
+export async function POST(
+  request: NextRequest,
+  { params }: { params: Promise<{ memorialId: string }> },
+) {
+  const { memorialId } = await params;
+
+  const { userId } = await auth();
+  if (!userId) return NextResponse.json({ success: false, error: 'Unauthorised' }, { status: 401 });
+
+  try {
+    await assertMemorialAccess(memorialId, userId, 'edit');
+  } catch (err) {
+    return handleAuthError(err);
+  }
+
+  const limited = await checkRateLimit(request, `bulk-prepare:${userId}`, { max: 30, windowMs: 60 * 60 * 1000 });
+  if (limited) return limited;
+
+  let body: { files?: unknown };
+  try { body = await request.json(); } catch {
+    return NextResponse.json({ success: false, error: 'Invalid request' }, { status: 400 });
+  }
+
+  const files = body?.files;
+  if (!Array.isArray(files) || files.length === 0) {
+    return NextResponse.json({ success: false, error: 'No files provided' }, { status: 400 });
+  }
+  if (files.length > BULK_LIMITS.maxFilesPerBatch) {
+    return NextResponse.json(
+      { success: false, error: `Up to ${BULK_LIMITS.maxFilesPerBatch} files per upload run` },
+      { status: 400 },
+    );
+  }
+
+  const inputs: BulkFileInput[] = files.map((f: any) => ({
+    name: typeof f?.name === 'string' ? f.name : '',
+    type: typeof f?.type === 'string' ? f.type : '',
+    size: typeof f?.size === 'number' ? f.size : NaN,
+  }));
+
+  const usage = await getMemorialStorageUsage(memorialId);
+  const plan  = planBulkBatch(inputs, usage.remainingBytes);
+
+  const direct = process.env.NODE_ENV === 'production';
+  let accepted: Array<Record<string, unknown>>;
+
+  if (direct) {
+    const { s3PresignedPut } = await import('@/lib/storage-s3');
+    accepted = await Promise.all(plan.accepted.map(async (a) => {
+      const ext = extensionOf(a.name);
+      const key = `collection/${memorialId}/${randomUUID()}${ext ? `.${ext}` : ''}`;
+      return { ...a, key, uploadUrl: await s3PresignedPut(key, a.mimeType) };
+    }));
+  } else {
+    accepted = plan.accepted.map((a) => ({ ...a }));
+  }
+
+  return NextResponse.json({
+    success: true,
+    data: {
+      mode: direct ? 'direct' : 'server',
+      accepted,
+      rejected: plan.rejected,
+      storage: usage,
+    },
+  });
+}
